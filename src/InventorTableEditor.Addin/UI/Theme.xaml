<!--
  Оформление окна редактора в стиле Inventor 2025 (светлая тема): плоские кнопки с голубой
  подсветкой, синий акцент Autodesk, тонкие серые границы. Загружается во время работы
  (EmbeddedResource + XamlReader), поэтому не зависит от pack-URI в процессе Inventor.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="WindowBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="CanvasBrush" Color="#E6E6E6" />
  <SolidColorBrush x:Key="TextBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0696D7" />
  <SolidColorBrush x:Key="AccentDarkBrush" Color="#0577AB" />
  <SolidColorBrush x:Key="HoverBrush" Color="#E5F1FB" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#A6D2F2" />
  <SolidColorBrush x:Key="PressedBrush" Color="#CCE4F7" />

  <!-- Плоская кнопка ленты и панели инструментов. -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Переключатель формата (Ж, К, Ч, индексы): нажатое состояние — голубая заливка с синей рамкой. -->
  <Style x:Key="FlatToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Основная кнопка диалога (Применить / Вставить в чертёж). -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Обычная кнопка диалога (Отмена). -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Подпись группы на ленте (снизу, как в Inventor). -->
  <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Заголовок раздела левой панели. -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <!-- Подпись слева от ряда кнопок («Столбец:», «Строка:»), как в КОМПАС-3D. -->
  <Style x:Key="RowLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Width" Value="62" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Поле ввода размеров (явный стиль: неявный попал бы и внутрь шаблона ComboBox). -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
</ResourceDictionary>
